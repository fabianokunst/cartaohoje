# ===========================================================================
# Cartao Hoje — Apache. Renomeie para .htaccess na raiz do site publicado.
# As URLs limpas ja funcionam pela estrutura de diretorios; o que esta aqui e
# host canonico, redirects de legado, 404 e cabecalhos.
# ===========================================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- host canonico: https + sem www -------------------------------------
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://cartaohoje.com.br%{REQUEST_URI} [R=301,L]

  # --- legado do WordPress -------------------------------------------------
  # Acrescente uma linha por URL antiga levantada no Search Console.
  RewriteRule ^hojepay/?$ /hoje-pay/ [R=301,L]

  # --- .html explicito -> URL limpa ---------------------------------------
  # /index.html primeiro: a regra generica o mandaria para /index/.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(.+?)/index\.html[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L]

  # --- barra final ---------------------------------------------------------
  # /hoje-pay e /hoje-pay/ sao a mesma pagina; so uma pode ser a canonica.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# --- tipos e charset -------------------------------------------------------
AddDefaultCharset UTF-8
AddType text/plain;charset=UTF-8 .txt
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType image/webp .webp

# --- compressao ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# --- cache -----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML sempre revalidado: e por ele que uma correcao chega ao usuario.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 week"
  # Estes tres mudam sem mudar de nome: cache curto.
  <FilesMatch "^(robots\.txt|sitemap\.xml|llms.*\.txt)$">
    ExpiresDefault "access plus 1 hour"
  </FilesMatch>
</IfModule>

# --- seguranca -------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- artefatos internos ----------------------------------------------------
<FilesMatch "^(_probe\.html|.*\.docx|.*\.md)$">
  Require all denied
</FilesMatch>
